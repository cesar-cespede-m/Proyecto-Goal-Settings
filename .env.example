# Placeholders: no incluir secretos reales en Git. Copiar como .env (ignorado por Git).
# Carpeta de datos privados (base SQLite goal_settings.sqlite3, archivos y artefactos).
# Para pruebas manuales, apuntar a una carpeta temporal. No compartir la misma carpeta
# entre el contenedor Docker (que monta ./runtime) y un Streamlit local a la vez:
# SQLite en modo WAL no tolera escrituras desde ambos lados.
GOAL_SETTINGS_RUNTIME_DIR=./runtime
# Los límites de carga (25 MB, 100.000 filas, 100 columnas) y la semilla de entrenamiento
# (42) son reglas fijas del producto definidas en core/; no se configuran por entorno.

# --- IA generativa (agnóstica del proveedor; ver docs/DATOS_IA_ML.md) ---
# false = "Modo sin IA generativa": el reporte por plantilla funciona igual.
LLM_ENABLED=false
# openai | openai_compatible | none
LLM_PROVIDER=openai
# Cualquier API compatible con POST {LLM_BASE_URL}/chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
# Modelo de ejemplo; confirma disponibilidad, coste y compatibilidad en tu cuenta.
# Puedes cambiarlo aquí por otro modelo compatible, sin modificar código.
LLM_MODEL=gpt-6-luna
# Nombre de la variable que guarda la clave (permite cambiar de proveedor sin renombrar).
LLM_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# json_schema (estricto) o json_object si el proveedor no soporta esquemas.
LLM_RESPONSE_FORMAT=json_schema
LLM_MAX_OUTPUT_TOKENS=1200
# OpenAI usa max_completion_tokens; algunos compatibles usan max_tokens.
LLM_MAX_OUTPUT_TOKENS_FIELD=max_completion_tokens
# Vacío = no se envía (algunos modelos no aceptan temperature).
LLM_TEMPERATURE=
